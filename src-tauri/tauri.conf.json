{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "乔巴便笺",
  "version": "1.2.1",
  "identifier": "com.chopper888.qiaoba-notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "乔巴便笺",
        "width": 380,
        "height": 620,
        "minWidth": 300,
        "minHeight": 400,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGMDNDODIyMDdEQjZDNUYKUldSZmJOc0hJc2dEUDZiWTJTTU5KSC9lNEF2c0Mydk5jMGhFc0dXK0dmaHkzYi9CQnNBSm54a0YK",
      "endpoints": [
        "https://github.com/Chopper888/qiaoba-notes/releases/latest/download/latest.json"
      ]
    }
  }
}
